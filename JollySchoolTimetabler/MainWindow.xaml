<Window x:Class="JollySchoolTimetabler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JollySchoolTimetabler"
        xmlns:views="clr-namespace:JollySchoolTimetabler.Views"
        mc:Ignorable="d"
        Title="JollyTimetabler" Height="1000" Width="1800" Style="{DynamicResource JollyWindowStyle}" Icon="/Timetable.ico" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="Reset Database" Command="{Binding ResetDatabaseCommand}" Width="100" Height="25" Margin="5" HorizontalAlignment="Left" />
            <Button Content="Generate Timetable" Command="{Binding GenerateTimetableCommand}" Width="120" Height="25" Margin="5" HorizontalAlignment="Left" />
            <Button Content="Curriculum" Command="{Binding ConfigureCurriculumCommand}" Width="100" Height="25" Margin="5" />
            <Button Content="Generation Details" Command="{Binding ShowGenerationDiagnosticsCommand}" Width="125" Height="25" Margin="5" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ProgressBar Width="115" Height="16" IsIndeterminate="True" VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,8,0" Width="660">
                    <TextBlock Text="{Binding GenerationPhase}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding GenerationDetail}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding GenerationDetail}"/>
                </StackPanel>
                <TextBlock Text="{Binding GenerationElapsed}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TabControl Width="Auto">
                <TabItem Header="Teachers">
                    <views:TeacherView />
                </TabItem>
                <TabItem Header="Students">
                    <views:StudentView />
                </TabItem>
                <TabItem Header="Year Groups">
                    <views:YearGroupView />
                </TabItem>
                <TabItem Header="Subjects">
                    <views:SubjectView />
                </TabItem>
                <TabItem Header="Rooms">
                    <views:RoomView />
                </TabItem>
                <TabItem Header="Classes">
                    <views:ClassView/>
                </TabItem>
            </TabControl>

            <Grid Grid.Column="1" Margin="5,0,5,5">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Expander Header="Generation diagnostics — solver activity and resource concerns" IsExpanded="True" Margin="0,0,0,5">
                    <Border Padding="8" Background="#FFF5E5">
                        <StackPanel>
                            <TextBlock Text="Solver activity" FontWeight="Bold" Foreground="#543C19"/>
                            <TextBlock Text="{Binding SolverActivity}" TextWrapping="Wrap" Foreground="#543C19" Margin="0,2,0,8"/>
                            <TextBlock Text="Teacher / room / student pressure" FontWeight="Bold" Foreground="#543C19"/>
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding ResourceConcerns}" TextWrapping="Wrap" Foreground="#543C19"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Expander>
                <views:TimetableView DataContext="{Binding Timetable}" Grid.Row="1" VerticalAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
